#lang pie
;; The Little Typer, chapter 15 (Imagine That...): negation as a function into Absurd, and
;; proofs that some things cannot be: zero is not add1 of anything, 1 is not 6. The book's
;; ¬ is spelled Not here: wat's reader, which wat-Pie uses, rejects ¬ as it rejects λ Π Σ →
;; (F-032). Our own examples on the chapter's topics. Racket's Pie prints each expression's
;; (the TYPE NORMAL-FORM); wat-Pie reads this same file and must print the same.

(claim Not (-> U U))
(define Not (lambda (X) (-> X Absurd)))
(Not Nat)
(the (Not Absurd) (lambda (x) x))

;; what an equality of Nats has as a consequence: Trivial, Absurd, or an equality one smaller
(claim =consequence (-> Nat Nat U))
(define =consequence
  (lambda (n j)
    (which-Nat n
      (which-Nat j Trivial (lambda (j-1) Absurd))
      (lambda (n-1) (which-Nat j Absurd (lambda (j-1) (= Nat n-1 j-1)))))))
(=consequence 0 0)
(=consequence 0 3)
(=consequence 5 0)
(=consequence 4 7)
(the (Pi ((n Nat)) U) (lambda (n) (=consequence (add1 n) 0)))

(claim =consequence-same (Pi ((n Nat)) (=consequence n n)))
(define =consequence-same
  (lambda (n) (ind-Nat n (lambda (k) (=consequence k k)) sole (lambda (n-1 =consequence-n-1) (same n-1)))))
(=consequence-same 0)
(=consequence-same 3)
=consequence-same

(claim use-Nat= (Pi ((n Nat) (j Nat)) (-> (= Nat n j) (=consequence n j))))
(define use-Nat= (lambda (n j n=j) (replace n=j (lambda (k) (=consequence n k)) (=consequence-same n))))
(use-Nat= 2 2 (same 2))
use-Nat=

(claim zero-not-add1 (Pi ((n Nat)) (Not (= Nat zero (add1 n)))))
(define zero-not-add1 (lambda (n) (use-Nat= zero (add1 n))))
zero-not-add1

(claim donut-absurdity (-> (= Nat 0 6) (= Atom 'powdered 'glazed)))
(define donut-absurdity (lambda (zero=six) (ind-Absurd (zero-not-add1 5 zero=six) (= Atom 'powdered 'glazed))))
donut-absurdity

(claim sub1= (Pi ((n Nat) (j Nat)) (-> (= Nat (add1 n) (add1 j)) (= Nat n j))))
(define sub1= (lambda (n j) (use-Nat= (add1 n) (add1 j))))
(sub1= 2 2 (same 3))
(claim one-not-six (Not (= Nat 1 6)))
(define one-not-six (lambda (one=six) (zero-not-add1 4 (sub1= 0 5 one=six))))
one-not-six
