#lang pie
;; The Little Typer, chapter 13 (Even Haf a Baker's Dozen): Either, left and right,
;; ind-Either, and even-or-odd: every Nat is Even or Odd. Our own examples on the chapter's
;; topics. Racket's Pie prints each expression's (the TYPE NORMAL-FORM); wat-Pie reads this
;; same file and must print the same.

(Either Nat Atom)
(the (Either Nat Atom) (left 3))
(the (Either Nat Atom) (right 'three))
(Either U Nat)
(ind-Either (the (Either Nat Atom) (left 3)) (lambda (x) Nat) (lambda (n) n) (lambda (a) 0))
(ind-Either (the (Either Nat Atom) (right 'x)) (lambda (x) Nat) (lambda (n) n) (lambda (a) 0))
(the (-> (Either Nat Nat) Nat) (lambda (e) (ind-Either e (lambda (x) Nat) (lambda (l) l) (lambda (r) (add1 r)))))
(the (-> (Either Nat Atom) (Either Atom Nat)) (lambda (e) (ind-Either e (lambda (x) (Either Atom Nat)) (lambda (n) (right n)) (lambda (a) (left a)))))

(claim + (-> Nat Nat Nat))
(define + (lambda (n j) (iter-Nat n j (lambda (k) (add1 k)))))
(claim double (-> Nat Nat))
(define double (lambda (n) (iter-Nat n 0 (+ 2))))
(claim Even (-> Nat U))
(define Even (lambda (n) (Sigma ((half Nat)) (= Nat n (double half)))))
(claim Odd (-> Nat U))
(define Odd (lambda (n) (Sigma ((haf Nat)) (= Nat n (add1 (double haf))))))
(claim zero-is-even (Even 0))
(define zero-is-even (cons 0 (same 0)))
(claim add1-even->odd (Pi ((n Nat)) (-> (Even n) (Odd (add1 n)))))
(define add1-even->odd (lambda (n e-n) (cons (car e-n) (cong (cdr e-n) (+ 1)))))
(claim add1-odd->even (Pi ((n Nat)) (-> (Odd n) (Even (add1 n)))))
(define add1-odd->even (lambda (n o-n) (cons (add1 (car o-n)) (cong (cdr o-n) (+ 1)))))

(claim mot-even-or-odd (-> Nat U))
(define mot-even-or-odd (lambda (k) (Either (Even k) (Odd k))))
(claim step-even-or-odd (Pi ((n-1 Nat)) (-> (mot-even-or-odd n-1) (mot-even-or-odd (add1 n-1)))))
(define step-even-or-odd
  (lambda (n-1 e-or-o-n-1)
    (ind-Either e-or-o-n-1
      (lambda (e-or-o) (mot-even-or-odd (add1 n-1)))
      (lambda (e-n-1) (right (add1-even->odd n-1 e-n-1)))
      (lambda (o-n-1) (left (add1-odd->even n-1 o-n-1))))))
(claim even-or-odd (Pi ((n Nat)) (Either (Even n) (Odd n))))
(define even-or-odd (lambda (n) (ind-Nat n mot-even-or-odd (left zero-is-even) step-even-or-odd)))
(even-or-odd 0)
(even-or-odd 2)
(even-or-odd 13)
step-even-or-odd
even-or-odd
