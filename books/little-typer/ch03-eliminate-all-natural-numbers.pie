#lang pie
;; The Little Typer, chapter 3 (Eliminate All Natural Numbers!): iter-Nat and rec-Nat,
;; + and * and gauss by elimination, and normal forms that get stuck on a variable.
;; Our own examples on the chapter's topics. Racket's Pie prints each expression's
;; (the TYPE NORMAL-FORM); wat-Pie reads this same file and must print the same.

;; iter-Nat: zero gives the base; (add1 n) gives the step applied to (iter-Nat n base step)
(iter-Nat 0 'fish (lambda (a) a))
(iter-Nat 4 0 (lambda (k) (add1 (add1 k))))
(iter-Nat 3 (the (Pair Nat Atom) (cons 0 'a)) (lambda (p) (cons (add1 (car p)) (cdr p))))

(claim step-+ (-> Nat Nat))
(define step-+ (lambda (sum-n-1) (add1 sum-n-1)))
(claim + (-> Nat Nat Nat))
(define + (lambda (n j) (iter-Nat n j step-+)))
(+ 2 3)
(+ 0 0)
+
(the (-> Nat Nat) (lambda (j) (+ 2 j)))
(the (-> Nat Nat) (lambda (j) (+ j 2)))
(check-same Nat (+ 17 3) 20)
(check-same (-> Nat Nat) (lambda (j) (+ 2 j)) (lambda (k) (add1 (add1 k))))

;; rec-Nat: the step also gets the smaller number
(rec-Nat 0 'zero (lambda (n-1 almost) 'more))
(rec-Nat 3 0 (lambda (n-1 almost) n-1))

(claim zerop (-> Nat Atom))
(define zerop (lambda (n) (rec-Nat n 't (lambda (n-1 zerop-n-1) 'nil))))
(zerop 0)
(zerop 37)
zerop

(claim gauss (-> Nat Nat))
(define gauss (lambda (n) (rec-Nat n 0 (lambda (n-1 gauss-n-1) (+ (add1 n-1) gauss-n-1)))))
(gauss 0)
(gauss 5)
(gauss 10)
gauss

(claim step-* (-> Nat Nat Nat Nat))
(define step-* (lambda (j n-1 mul-n-1) (+ j mul-n-1)))
(claim * (-> Nat Nat Nat))
(define * (lambda (n j) (rec-Nat n 0 (step-* j))))
(* 2 29)
(* 0 7)
(* 3 0)
(step-* 3)
(the (-> Nat Nat) (lambda (j) (* 2 j)))
(the (-> Nat Nat) (lambda (j) (* j 2)))

(claim fact (-> Nat Nat))
(define fact (lambda (n) (rec-Nat n 1 (lambda (n-1 fact-n-1) (* (add1 n-1) fact-n-1)))))
(fact 0)
(fact 5)
(check-same Nat (fact 4) (* 4 6))
