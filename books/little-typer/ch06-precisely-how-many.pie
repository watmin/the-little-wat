#lang pie
;; The Little Typer, chapter 6 (Precisely How Many?): Vec, vecnil and vec::, head and tail,
;; and functions whose types say how long a list is. Our own examples on the chapter's
;; topics. Racket's Pie prints each expression's (the TYPE NORMAL-FORM); wat-Pie reads this
;; same file and must print the same.

(the (Vec Atom 0) vecnil)
(the (Vec Atom 2) (vec:: 'oyster (vec:: 'clam vecnil)))
(Vec Nat 3)
(the U (Vec (List Atom) 2))
(Vec U 1)
(head (the (Vec Atom 1) (vec:: 'a vecnil)))
(tail (the (Vec Atom 2) (vec:: 'a (vec:: 'b vecnil))))

(claim first-of-one (Pi ((E U)) (-> (Vec E 1) E)))
(define first-of-one (lambda (E es) (head es)))
(first-of-one Atom (vec:: 'shiitake vecnil))
first-of-one

(claim first (Pi ((E U) (l Nat)) (-> (Vec E (add1 l)) E)))
(define first (lambda (E l es) (head es)))
(first Atom 2 (vec:: 'chicken-of-the-woods (vec:: 'chantarelle (vec:: 'lions-mane vecnil))))
first

(claim rest (Pi ((E U) (l Nat)) (-> (Vec E (add1 l)) (Vec E l))))
(define rest (lambda (E l es) (tail es)))
(rest Atom 1 (vec:: 'a (vec:: 'b vecnil)))
rest
(the (Pi ((n Nat)) (-> (Vec Nat (add1 (add1 n))) Nat)) (lambda (n es) (head (tail es))))

;; lengths and element types that compute
(claim Vec-of-3 (-> U U))
(define Vec-of-3 (lambda (E) (Vec E 3)))
(the (Vec-of-3 Nat) (vec:: 1 (vec:: 2 (vec:: 3 vecnil))))
(the (Vec Nat (iter-Nat 2 1 (lambda (k) (add1 k)))) (vec:: 7 (vec:: 8 (vec:: 9 vecnil))))
(the (Pi ((n Nat)) (-> (Vec Atom (add1 n)) (Vec Atom (add1 n)))) (lambda (n es) es))

;; the normal form of a Vec variable, by its length
(the (Pi ((E U)) (-> (Vec E 0) (Vec E 0))) (lambda (E es) es))
(the (Pi ((E U)) (-> (Vec E 1) (Vec E 1))) (lambda (E es) es))
