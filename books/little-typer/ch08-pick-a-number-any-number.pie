#lang pie
;; The Little Typer, chapter 8 (Pick a Number, Any Number): the = type, same, cong, and
;; incr=add1 by ind-Nat. Our own examples on the chapter's topics. Racket's Pie prints each
;; expression's (the TYPE NORMAL-FORM); wat-Pie reads this same file and must print the same.

(= Atom 'kale 'kale)
(the (= Atom 'kale 'kale) (same 'kale))
(= Nat 1 2)
(the U (= (Pair Nat Atom) (cons 1 'a) (cons 1 'a)))
(the U (= (-> Nat Nat) (lambda (n) n) (lambda (m) m)))
(= U Nat Nat)

(claim + (-> Nat Nat Nat))
(define + (lambda (n j) (iter-Nat n j (lambda (k) (add1 k)))))
(the (= Nat (+ 2 3) 5) (same 5))
(the (= Nat (+ 2 3) 5) (same (+ 1 4)))
(the (Pi ((n Nat)) (= Nat (+ 1 n) (add1 n))) (lambda (n) (same (add1 n))))

(claim +1=add1 (Pi ((n Nat)) (= Nat (+ 1 n) (add1 n))))
(define +1=add1 (lambda (n) (same (add1 n))))
+1=add1
(+1=add1 5)

(claim incr (-> Nat Nat))
(define incr (lambda (n) (iter-Nat n 1 (+ 1))))
incr
(incr 3)

;; cong: from (= X from to) and a function f from X, (= Y (f from) (f to))
(cong (the (= Nat 2 2) (same 2)) (+ 1))
(the (Pi ((n Nat) (m Nat)) (-> (= Nat n m) (= Nat (add1 n) (add1 m)))) (lambda (n m n=m) (cong n=m (+ 1))))

(claim mot-incr=add1 (-> Nat U))
(define mot-incr=add1 (lambda (k) (= Nat (incr k) (add1 k))))
(mot-incr=add1 2)
(claim step-incr=add1 (Pi ((n-1 Nat)) (-> (mot-incr=add1 n-1) (mot-incr=add1 (add1 n-1)))))
(define step-incr=add1 (lambda (n-1 incr=add1-n-1) (cong incr=add1-n-1 (+ 1))))
step-incr=add1
(claim incr=add1 (Pi ((n Nat)) (= Nat (incr n) (add1 n))))
(define incr=add1 (lambda (n) (ind-Nat n mot-incr=add1 (same (add1 zero)) step-incr=add1)))
(incr=add1 2)
incr=add1
(check-same (= Nat 3 3) (incr=add1 2) (same 3))
