;; probes/grep/written-is-exact.wat: is wat-grep's `Written` predicate exact, at corpus scale?
;;
;; `Named` says WHAT a node is called; `Written` says AND IT IS SPELLED HERE. The distinction
;; exists because the reader synthesizes nodes: `~x` reads as a node NAMED
;; `:wat::core::unquote` whose span covers the token `~x`, so a REWRITING rule that joined
;; `Named` to `Span` would overwrite `~x` with the text `:wat::core::unquote`. wat-rs measured
;; that as 50 real corruption sites before it was fixed, one of them a test asserting two chars
;; unequal, which would have been INVERTED rather than broken.
;;
;; The guard, from grep.wat:80-85:
;;
;;   `ast-name` returns verbatim token TEXT, so for a single-line named node
;;   `end-col - col == length(name)` iff the name is actually spelled at that span;
;;   NOT A HEURISTIC.
;;
;; and the audit note that drove it claims it is exact on its sample: "empirically 172/172
;; genuine matches satisfied it and 50/50 phantoms violated it; now it is grounded in the
;; mechanism as well as the sample."
;;
;; 222 nodes is a sample. This repository is 533 files and 136,697 nodes, of which 85,347 are
;; Named and 79,749 Written -- so 5,598 nodes carry a name that the predicate says is not
;; spelled at its span. If the predicate is exact, EVERY ONE of those 5,598 must be a
;; reader-synthesized name: unquote, quasiquote, unquote-splicing, char/of, holon/literal and
;; nothing else. One ordinary name in that set means the predicate over-rejects, and a rewriting
;; rule would silently skip real sites -- the quiet direction of the same bug.
;;
;; This prints one UNWRITTEN line per such node so the set can be tallied outside wat.
;;
;; Run from the repository root: wat probes/grep/written-is-exact.wat

(:wat::core::typealias :we::Paths (:wat::core::Vector :- [:wat::core::String]))
(:wat::core::typealias :we::IdSet (:wat::core::PersistentMap :- [:wat::core::i64 :wat::core::bool]))

(:wat::core::defn :we::written-ids [f <- :wat::grep::Facts] -> :we::IdSet
  (:wat::core::foldl
    (:wat::core::fn [m <- :we::IdSet w <- :wat::grep::Written] -> :we::IdSet
      (:wat::map::assoc m (:wat::grep::Written/id w) true))
    (:wat::core::PersistentMap :- [:wat::core::i64 :wat::core::bool])
    (:wat::grep::Facts/written f)))

(:wat::core::typealias :we::KindMap (:wat::core::PersistentMap :- [:wat::core::i64 :wat::core::String]))

(:wat::core::defn :we::kind->s [k <- :wat::grep::NodeKind] -> :wat::core::String
  (:wat::core::match k
    [:wat::grep::NodeKind.IntLit {} "IntLit"]
    [:wat::grep::NodeKind.FloatLit {} "FloatLit"]
    [:wat::grep::NodeKind.RationalLit {} "RationalLit"]
    [:wat::grep::NodeKind.BigIntLit {} "BigIntLit"]
    [:wat::grep::NodeKind.CharLit {} "CharLit"]
    [:wat::grep::NodeKind.BoolLit {} "BoolLit"]
    [:wat::grep::NodeKind.StringLit {} "StringLit"]
    [:wat::grep::NodeKind.NilLit {} "NilLit"]
    [:wat::grep::NodeKind.Keyword {} "Keyword"]
    [:wat::grep::NodeKind.Symbol {} "Symbol"]
    [:wat::grep::NodeKind.List {} "List"]
    [:wat::grep::NodeKind.Vector {} "Vector"]
    [:wat::grep::NodeKind.Set {} "Set"]
    [:wat::grep::NodeKind.Map {} "Map"]))

(:wat::core::defn :we::kinds [f <- :wat::grep::Facts] -> :we::KindMap
  (:wat::core::foldl
    (:wat::core::fn [m <- :we::KindMap n <- :wat::grep::Node] -> :we::KindMap
      (:wat::map::assoc m (:wat::grep::Node/id n) (:we::kind->s (:wat::grep::Node/kind n))))
    (:wat::core::PersistentMap :- [:wat::core::i64 :wat::core::String])
    (:wat::grep::Facts/nodes f)))

(:wat::core::defn :we::kind-at [m <- :we::KindMap id <- :wat::core::i64] -> :wat::core::String
  (:wat::core::match (:wat::map::get m id)
    [:wat::core::Option.Some {:value v} v]
    [:wat::core::Option.None {} "?"]))

;; How many Written facts are themselves string literals? A StringLit's span covers its quotes,
;; so end-col - col == length(name) + 2 always, and the predicate can never admit one. If this
;; is 0 across the corpus, that is proved rather than argued.
(:wat::core::defn :we::written-strings [f <- :wat::grep::Facts km <- :we::KindMap] -> :wat::core::i64
  (:wat::core::foldl
    (:wat::core::fn [a <- :wat::core::i64 w <- :wat::grep::Written] -> :wat::core::i64
      (:wat::core::if (:wat::core::= (:we::kind-at km (:wat::grep::Written/id w)) "StringLit")
        (:wat::core::+ a 1) a))
    0 (:wat::grep::Facts/written f)))

(:wat::core::defn :we::in? [m <- :we::IdSet id <- :wat::core::i64] -> :wat::core::bool
  (:wat::core::match (:wat::map::get m id)
    [:wat::core::Option.Some {:value v} v]
    [:wat::core::Option.None {} false]))

;; Print the name of every Named node that carries no Written fact, and return how many.
(:wat::core::defn :we::report [path <- :wat::core::String] -> :wat::core::i64
  (:wat::core::let [facts (:wat::grep::facts-of path (:wat::io::read-file path))
                    wids  (:we::written-ids facts)
                    kmap  (:we::kinds facts)
                    ;; foldl, not filterv: :wat::core::filterv is the ONE core sequence verb
                    ;; that has no PersistentVector clause, and every vector in grep::Facts is a
                    ;; PersistentVector. See F-080.
                    miss  (:wat::core::foldl
                            (:wat::core::fn [a <- :wat::core::i64 n <- :wat::grep::Named] -> :wat::core::i64
                              (:wat::core::if (:we::in? wids (:wat::grep::Named/id n))
                                a
                                (:wat::core::do
                                  (:wat::kernel::println
                                    (:wat::string::concat "UNWRITTEN "
                                      (:wat::string::concat (:we::kind-at kmap (:wat::grep::Named/id n))
                                        (:wat::string::concat " " (:wat::grep::Named/name n)))))
                                  (:wat::core::+ a 1))))
                            0
                            (:wat::grep::Facts/named facts))]
    (:wat::core::do
      (:wat::kernel::println (:wat::string::concat "WRITTEN-STRINGLITS "
        (:wat::i64::to-string (:we::written-strings facts kmap))))
      (:wat::kernel::println (:wat::string::concat "TOTALS "
        (:wat::string::concat (:wat::i64::to-string (:wat::core::length (:wat::grep::Facts/nodes facts)))
          (:wat::string::concat " "
            (:wat::string::concat (:wat::i64::to-string (:wat::core::length (:wat::grep::Facts/named facts)))
              (:wat::string::concat " "
                (:wat::i64::to-string (:wat::core::length (:wat::grep::Facts/written facts)))))))))
      miss)))
