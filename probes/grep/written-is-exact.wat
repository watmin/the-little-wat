(:wat::core::defn :user::main [] -> :wat::core::nil
  (:wat::core::let
    [ns (:wat::core::mapv :we::report (:we::paths))
     total (:wat::core::foldl
             (:wat::core::fn [a <- :wat::core::i64 n <- :wat::core::i64] -> :wat::core::i64
               (:wat::core::+ a n))
             0 ns)]
    (:wat::kernel::println (:wat::string::concat "TOTAL-UNWRITTEN " (:wat::i64::to-string total)))))
