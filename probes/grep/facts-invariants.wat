;; probes/grep/facts-invariants.wat: wat-grep against its own declared contract.
;;
;; :wat::grep:: is the code-search engine the formatter is built on -- fmt.wat calls
;; (:wat::grep::facts-of path src) to turn a file into a fact base the rete then queries. It is
;; 489 lines, 13 functions, 12 records, and it appears in NO user-facing page (the F-065 shape).
;;
;; Its header states a law and names its own control, verbatim:
;;
;;   * NON-VACUITY: `Node` must exceed `Named` on any real file. `Span` is emitted
;;     UNCONDITIONALLY beside `Node` (unlike `Named`) because `ast-span`/`ast-end-span` are
;;     TOTAL -- Span == Node is the non-vacuity control for that half.
;;
;; and it records a shipped measurement:
;;
;;   shipped numbers: `5d650b807`, wat/fix.wat Node=4316 Span=4316
;;
;; So this file asks three questions the subsystem has already committed to answers for:
;;
;;   1. Does Span == Node hold on every file? (a total function's output count)
;;   2. Does Node > Named hold on every file? (the non-vacuity claim)
;;   3. Does wat/fix.wat still measure 4316/4316?
;;
;; and one it commits to by its types rather than its prose: `Facts` carries an `unreadable`
;; vector and `facts-of` matches `ReadOutcome.Malformed`, so a file that does not parse should
;; be REPORTED, not raised. That is the direct counter-test to F-078, where lint-file raises on
;; the same input and discards the whole batch.
;;
;; Run from the repository root: wat probes/grep/facts-invariants.wat

(:wat::core::typealias :gi::Paths (:wat::core::Vector :- [:wat::core::String]))
(:wat::core::typealias :gi::Tally (:wat::core::PersistentMap :- [:wat::core::String :wat::core::i64]))

(:wat::core::defn :gi::facts [path <- :wat::core::String] -> :wat::grep::Facts
  (:wat::grep::facts-of path (:wat::io::read-file path)))

(:wat::core::defn :gi::n-nodes [f <- :wat::grep::Facts] -> :wat::core::i64
  (:wat::core::length (:wat::grep::Facts/nodes f)))
(:wat::core::defn :gi::n-named [f <- :wat::grep::Facts] -> :wat::core::i64
  (:wat::core::length (:wat::grep::Facts/named f)))
(:wat::core::defn :gi::n-spans [f <- :wat::grep::Facts] -> :wat::core::i64
  (:wat::core::length (:wat::grep::Facts/spans f)))
(:wat::core::defn :gi::n-written [f <- :wat::grep::Facts] -> :wat::core::i64
  (:wat::core::length (:wat::grep::Facts/written f)))
(:wat::core::defn :gi::n-unreadable [f <- :wat::grep::Facts] -> :wat::core::i64
  (:wat::core::length (:wat::grep::Facts/unreadable f)))

;; Law 1: spans are emitted unconditionally beside nodes, so the counts must be equal.
(:wat::core::defn :gi::span-law? [f <- :wat::grep::Facts] -> :wat::core::bool
  (:wat::core::= (:gi::n-spans f) (:gi::n-nodes f)))

;; Law 2: a real file has more nodes than names (non-vacuity). Only meaningful when the file
;; actually parsed -- an unreadable file has 0 and 0, which is not a violation, it is no data.
(:wat::core::defn :gi::named-law? [f <- :wat::grep::Facts] -> :wat::core::bool
  (:wat::core::if (:wat::core::= (:gi::n-nodes f) 0)
    true
    (:wat::core::> (:gi::n-nodes f) (:gi::n-named f))))

(:wat::core::defn :gi::say [label <- :wat::core::String n <- :wat::core::i64] -> :wat::core::nil
  (:wat::kernel::println (:wat::string::concat label (:wat::i64::to-string n))))

(:wat::core::defn :gi::sum [g <- [:wat::grep::Facts :-> :wat::core::i64]
                            fs <- (:wat::core::Vector :- [:wat::grep::Facts])] -> :wat::core::i64
  (:wat::core::foldl
    (:wat::core::fn [a <- :wat::core::i64 f <- :wat::grep::Facts] -> :wat::core::i64
      (:wat::core::+ a (g f)))
    0 fs))

(:wat::core::defn :gi::count-false [g <- [:wat::grep::Facts :-> :wat::core::bool]
                                    fs <- (:wat::core::Vector :- [:wat::grep::Facts])] -> :wat::core::i64
  (:wat::core::length (:wat::core::filterv
    (:wat::core::fn [f <- :wat::grep::Facts] -> :wat::core::bool (:wat::core::not (g f))) fs)))
