(:wat::core::defn :user::main [] -> :wat::core::nil
  (:wat::core::let
    [fix (:gi::facts "../wat-rs/wat/fix.wat")
     fs  (:wat::core::mapv :gi::facts (:gi::paths))]
    (:wat::core::do
      (:wat::kernel::println "---- the shipped number: wat/fix.wat Node=4316 Span=4316 ----")
      (:gi::say "  Node:            " (:gi::n-nodes fix))
      (:gi::say "  Span:            " (:gi::n-spans fix))
      (:gi::say "  Named:           " (:gi::n-named fix))
      (:wat::kernel::println "---- this repository's corpus ----")
      (:gi::say "files:             " (:wat::core::length fs))
      (:gi::say "  Node facts:      " (:gi::sum :gi::n-nodes fs))
      (:gi::say "  Named facts:     " (:gi::sum :gi::n-named fs))
      (:gi::say "  Span facts:      " (:gi::sum :gi::n-spans fs))
      (:gi::say "  Written facts:   " (:gi::sum :gi::n-written fs))
      (:gi::say "  Unreadable:      " (:gi::sum :gi::n-unreadable fs))
      (:wat::kernel::println "---- the two declared laws ----")
      (:gi::say "  Span == Node violations:  " (:gi::count-false :gi::span-law? fs))
      (:gi::say "  Node >  Named violations: " (:gi::count-false :gi::named-law? fs)))))
