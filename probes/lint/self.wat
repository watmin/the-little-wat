;; probes/lint/self.wat: what does wat's linter say about the code this repository wrote?
;;
;; probes/lint/stdlib.wat asked the linter about wat's own stdlib and got 99 findings, all
;; concat-abuse, all recommending :wat::core::format (F-076). This asks the same question of the
;; other side of the experiment: 500-odd wat programs written by a model with the documentation
;; in front of it, which reached for string::concat hundreds of times and format not once.
;;
;; Two things had to be worked around to ask it at all, both recorded as F-078:
;;
;;   1. lint-source raises on the first file that does not lex and loses every finding from
;;      every other file in the batch. This corpus deliberately contains programs that do not
;;      parse -- they are negative probes, that is their whole point -- so each file is screened
;;      with test::run-thread first and the unlexable ones are set aside.
;;   2. The raise does not name the file. source::File carries :path and lint-file has it in
;;      hand, but the error says only "byte 258" and points at wat/lint.wat:586. Finding the
;;      culprit in a 532-file batch meant grepping all 532 outside wat.
;;
;; It also runs the rule the front door cannot reach. lint-stdlib is the only entry point that
;; runs wat's COMPLETE rule set -- form rules plus rule-zero, the deporder load-order check --
;; and it is hardcoded to deporder::stdlib-sources, so it lints wat's own stdlib and nothing
;; else. lint-source, the entry point an outside project gets, runs form rules only: 2 of the 3
;; rules. Getting the third means reassembling lint-stdlib's five-line body by hand, which is
;; what :sl::rule-zero does below. That is F-079 -- a missing export, not a design problem.
;;
;; The path list below is a snapshot, generated by find at the time this probe was written, and
;; it includes this file -- the probe lints itself. Regenerate it if the corpus grows.
;;
;; Run from the repository root: wat probes/lint/self.wat

(:wat::core::typealias :sl::Files (:wat::core::Vector :- [:wat::source::File]))
(:wat::core::typealias :sl::Findings (:wat::core::Vector :- [:wat::lint::Finding]))
(:wat::core::typealias :sl::Paths (:wat::core::Vector :- [:wat::core::String]))

(:wat::core::defn :sl::load [path <- :wat::core::String] -> :wat::source::File
  (:wat::source::File :path path :source (:wat::io::read-file path)))

;; Does this file survive the linter at all? run-thread is the only general catch (F-063).
(:wat::core::defn :sl::lexes? [path <- :wat::core::String] -> :wat::core::bool
  (:wat::core::match (:wat::test::run-thread (:wat::lint::lint-file (:sl::load path)))
    [:wat::kernel::RunResult.Passed {} true]
    [:wat::kernel::RunResult.Failed {:failure f} false]))

(:wat::core::defn :sl::count-rule [fs <- :sl::Findings r <- :wat::core::String] -> :wat::core::i64
  (:wat::core::length (:wat::core::filterv
    (:wat::core::fn [f <- :wat::lint::Finding] -> :wat::core::bool
      (:wat::core::= (:wat::lint::Finding/rule f) r)) fs)))

;; rule-zero over our own files -- lint-stdlib's body, with our sources instead of the stdlib's.
(:wat::core::defn :sl::rule-zero [files <- :sl::Files] -> :sl::Findings
  (:wat::lint::violations->findings (:wat::deporder::verify files)))

;; deporder::verify reads its whole argument as ONE ordered load sequence -- that is what the
;; stdlib is. These 530 files are 530 independent programs, so asking it about all of them at
;; once is a category error on our part, and the number it returns says so. Per file is the
;; honest question.
(:wat::core::defn :sl::rule-zero-1 [f <- :wat::source::File] -> :wat::core::i64
  (:wat::core::length (:sl::rule-zero (:wat::core::Vector :- [:wat::source::File] f))))

(:wat::core::defn :sl::rule-zero-each [files <- :sl::Files] -> :wat::core::i64
  (:wat::core::foldl
    (:wat::core::fn [a <- :wat::core::i64 f <- :wat::source::File] -> :wat::core::i64
      (:wat::core::+ a (:sl::rule-zero-1 f)))
    0 files))

(:wat::core::defn :sl::fixable [fs <- :sl::Findings] -> :wat::core::i64
  (:wat::core::length (:wat::core::filterv
    (:wat::core::fn [f <- :wat::lint::Finding] -> :wat::core::bool
      (:wat::core::match (:wat::lint::Finding/fix f)
        [:wat::core::Option.Some {:value v} true]
        [:wat::core::Option.None {} false])) fs)))

(:wat::core::defn :sl::say [label <- :wat::core::String n <- :wat::core::i64] -> :wat::core::nil
  (:wat::kernel::println (:wat::string::concat label (:wat::i64::to-string n))))
