(:wat::core::defn :user::main [] -> :wat::core::nil
  (:wat::core::let [all (:sl::paths)
                    ok (:wat::core::filterv :sl::lexes? all)
                    files (:wat::core::mapv :sl::load ok)
                    fs (:wat::lint::lint-source files)
                    rz (:sl::rule-zero files)]
    (:wat::core::do
      (:sl::say "files in corpus:   " (:wat::core::length all))
      (:sl::say "  lintable:        " (:wat::core::length ok))
      (:sl::say "  refused to lex:  " (:wat::core::- (:wat::core::length all) (:wat::core::length ok)))
      (:sl::say "findings:          " (:wat::core::length fs))
      (:sl::say "  concat-abuse:    " (:sl::count-rule fs "concat-abuse"))
      (:sl::say "  if-=-ladder:     " (:sl::count-rule fs "nested-if-=-ladder"))
      (:sl::say "  auto-fixable:    " (:sl::fixable fs))
      (:sl::say "rule-zero (by hand):" (:wat::core::length rz))
      (:sl::say "  load-order:      " (:sl::count-rule rz "load-order"))
      (:sl::say "rule-zero per file: " (:sl::rule-zero-each files)))))
